{
  "name": "grok-display",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DISPLAY",
        "class_name": "DisplayDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DisplayDO"]
    }
  ]
}
